# Copia a .env para cambiar los valores por defecto. NO subas .env a git.
# En Coolify, define estas variables en la configuración del servicio en lugar de usar .env.

# Token Bearer del servidor HTTP. Obligatorio si escucha fuera de localhost.
# Genéralo con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# Ruta de la base SQLite (por defecto ~/.claude/session-log.db; en Docker /data/session-log.db)
SESSION_LOG_DB=~/.claude/session-log.db
SESSION_LOG_TZ=America/Panama

# Solo modo HTTP sin Docker (en Docker ya vienen definidos)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Orígenes de navegador permitidos, separados por comas. Vacío = rechaza cualquier petición con Origin.
MCP_ALLOWED_ORIGINS=
